{
  "name": "alco-content-engine",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -p 3000",
    "desktop:dev": "concurrently \"next dev -p 3102\" \"wait-on http://127.0.0.1:3102 && electron .\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint",
    "verify:build": "npm run typecheck && npm run lint && cross-env NODE_ENV=production next build",
    "verify:stability": "node scripts/validate-stability.mjs",
    "verify:funnel": "node scripts/test-funnel-authority.mjs",
    "verify:full": "npm run verify:stability && npm run verify:funnel && npm run typecheck && npm run lint && cross-env NODE_ENV=production next build",
    "desktop:build": "cross-env NODE_ENV=production next build && electron-builder --config electron-builder.json --win nsis"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "2.8.0",
    "@hookform/resolvers": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "15.5.19",
    "postcss": "^8.5.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "styled-jsx": "5.1.6",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.19",
    "tailwindcss": "4.1.11",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "wait-on": "^9.0.0"
  }
}
